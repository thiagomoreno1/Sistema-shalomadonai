[Unit]
Description=Deploy validated Shalom Adonai web build from public GitHub main
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/shalom-deploy.env
ExecStart=/usr/local/sbin/shalom-deploy-poller.py
TimeoutStartSec=30min
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/shalom-deploy /var/www/shalom-releases /var/lib/shalom-deploy /run/docker.sock