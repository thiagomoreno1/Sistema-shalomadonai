shalomadonai.duckdns.org {
	@evolution path /evolution /evolution/*
	handle @evolution {
		uri strip_prefix /evolution
		reverse_proxy 127.0.0.1:8081 {
			header_up Origin https://shalomadonai.duckdns.org
		}
	}

	handle {
		root * /var/www/shalom-releases/current
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
