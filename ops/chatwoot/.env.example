# Copy this file to .env on the VPS and replace every placeholder before startup.
CHATWOOT_DOMAIN=chat.example.com
CADDY_EMAIL=admin@example.com
# Public IP or CIDR allowed to create the first Chatwoot administrator.
BOOTSTRAP_ADMIN_IP=203.0.113.10/32

# Generate alphanumeric values locally with: openssl rand -hex 32
SECRET_KEY_BASE=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_VALUE
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_VALUE
REDIS_PASSWORD=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_VALUE

# Keep public account signup disabled after initial owner setup.
ENABLE_ACCOUNT_SIGNUP=false
LOG_LEVEL=info

# SMTP is required for password resets and team invitation emails.
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
